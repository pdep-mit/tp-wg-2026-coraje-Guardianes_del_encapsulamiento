import cajas.*
import wollok.game.*
import Personajes.*
import equipos.*
import ManagerDeTurnos.*
import seleccionador.*
import menu.*

program jueguito {
  game.width(25)
  game.height(15)
  game.cellSize(32)
  game.title("Juego")
  game.boardGround("FondoNivelGrande.png")

  managerDeEquipos.agregarEquipo(equipoAzul)
  managerDeEquipos.agregarEquipo(equipoRojo)
  
  menu.iniciar(equipoAzul)

  game.start()
  


}
