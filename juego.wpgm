import cajas.*
import wollok.game.*
import Personajes.*
import equipos.*
import ManagerDeTurnos.*
import seleccionador.*
import menu.*

program jueguito {
  game.width(20)
  game.height(11)
  game.cellSize(32)
  game.title("Juego")
  game.boardGround("FondoNivel.png")
  // hay que rehacer el fondo para que quede bien en un tamaño de pantalla mayor, porque despues no se puede cambiar el tamaño de la pantalla y seria mejor si los niveles fueran más grandes

 

  managerDeEquipos.agregarEquipo(equipoAzul)
  managerDeEquipos.agregarEquipo(equipoRojo)
  
  menu.iniciar(equipoAzul)

  game.start()
  


}

